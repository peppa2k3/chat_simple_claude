FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install --production

COPY . .

EXPOSE 3000

CMD ["npm", "start"]


FROM node:18-alpine
WORKDIR /app
COPY package*.json ./
RUN  npm install
COPY . .
EXPOSE 3000

CMD ["npm","start"]

#STAGE 0 , build image
FROM node:18-alpine as dist
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

#STAGE 1 , product image
FROM nginx:alpine
COPY --from=dist ./app/dist ./user/nginx/share/html/
COPY nginx.conf ./etc/nginx/config.d/default.conf
EXPOSE 80
CMD ["nginx","-g","daemon;"]
